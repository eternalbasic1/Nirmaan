{
  "name": "cerahub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3002",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write components pages lib styles tests *.ts *.mjs *.js *.json README.md docs",
    "format:check": "prettier --check components pages lib styles tests *.ts *.mjs *.js *.json README.md docs",
    "test:smoke": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
